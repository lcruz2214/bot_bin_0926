# ==========================================
# BOT BINANCE - CONFIGURAÇÕES DE AMBIENTE (PRODUÇÃO)
# ==========================================

# Chave secreta de sessão Flask
SECRET_KEY=bot_binance_super_secret_secure_key_2026

# Banco de Dados PostgreSQL (Homelab ZimaOS)
# IP da instância no homelab: 192.168.100.50
POSTGRES_HOST=192.168.100.50
POSTGRES_PORT=5432
POSTGRES_DB=postgresql
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@192.168.100.50:5432/postgresql

# Modo de Execução / Segurança
PAPER_TRADING=true
INITIAL_BALANCE_USDT=10000.0

# Chaves de API Binance (Opcional no modo Simulação; Obrigatório apenas no Modo Real)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# Ativos e Timeframe padrão
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT
DEFAULT_TIMEFRAME=1m

# Servidor Web
HOST=0.0.0.0
PORT=5000
DEBUG=false
